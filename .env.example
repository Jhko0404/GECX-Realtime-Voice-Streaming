# GCP Core Configuration
PROJECT_ID=your-gcp-project-id
LOCATION=us
APP_ID=your-gecx-app-id
DEPLOYMENT_ID=default
REGION=us-central1

# Service Names
SERVICE_NAME=gecx-streaming-bff
